# Supabase APIのURL
# ローカル開発: http://127.0.0.1:54321
# 本番環境: https://your-project-ref.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Supabase 匿名キー (anon key)
# supabase start 実行時に表示される
# 読み取り専用の公開キー
SUPABASE_ANON_KEY=実際のsupabaseのAuthentication Keys(publish)

# Supabase サービスロールキー (service_role key)
# supabase start 実行時に表示される
# フルアクセス権限を持つ秘密鍵（バックエンドのみで使用）
SUPABASE_SERVICE_ROLE_KEY=実際のsupabaseのAuthentication Keys(Secret)

# PostgreSQL 直接接続URL（オプション）
# pgvectorを直接操作する場合に使用
# ローカル: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
